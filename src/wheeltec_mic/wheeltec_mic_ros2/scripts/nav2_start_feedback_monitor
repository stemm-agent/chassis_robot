#!/usr/bin/env python3
import os
import time

import rclpy
from nav2_msgs.action import NavigateToPose
from rclpy.action import ActionClient
from rclpy.node import Node
from std_msgs.msg import String


class Nav2StartFeedbackMonitor(Node):
    def __init__(self):
        super().__init__('nav2_start_feedback_monitor')
        self.declare_parameter('start_commands', ['开启导航'])
        self.declare_parameter('started_audio', '/navigation_started.wav')
        self.declare_parameter('fallback_audio', '/OK.wav')
        self.declare_parameter('audio_path', '')
        self.declare_parameter('monitor_timeout_sec', 60.0)
        self.declare_parameter('check_period_sec', 0.5)
        self.declare_parameter('required_nav2_nodes', [
            'bt_navigator',
            'controller_server',
            'planner_server',
        ])

        self.start_commands = set(self.get_parameter('start_commands').value)
        self.started_audio = self.get_parameter('started_audio').value
        self.fallback_audio = self.get_parameter('fallback_audio').value
        self.audio_path = self.get_parameter('audio_path').value
        self.monitor_timeout_sec = float(self.get_parameter('monitor_timeout_sec').value)
        self.check_period_sec = float(self.get_parameter('check_period_sec').value)
        self.required_nav2_nodes = set(self.get_parameter('required_nav2_nodes').value)

        self.feedback_pub = self.create_publisher(String, 'feedback_audio', 10)
        self.voice_sub = self.create_subscription(String, 'voice_words', self._voice_words_callback, 10)
        self.nav_to_pose_client = ActionClient(self, NavigateToPose, 'navigate_to_pose')

        self._watching = False
        self._deadline = 0.0
        self._timer = self.create_timer(self.check_period_sec, self._check_nav2)
        self.get_logger().info('nav2_start_feedback_monitor ready: commands=%s audio=%s' % (
            sorted(self.start_commands), self.started_audio))

    def _voice_words_callback(self, msg):
        command = msg.data.strip()
        if command not in self.start_commands:
            return
        self._watching = True
        self._deadline = time.monotonic() + self.monitor_timeout_sec
        self.get_logger().info('Start monitoring Nav2 startup after voice command: %s' % command)

    def _check_nav2(self):
        if not self._watching:
            return

        if self._nav2_online():
            self._watching = False
            self._publish_feedback(self._select_audio())
            self.get_logger().info('Nav2 is online; navigation-start feedback published.')
            return

        if time.monotonic() > self._deadline:
            self._watching = False
            self.get_logger().warn('Nav2 did not become online within %.1fs after start command.' %
                                   self.monitor_timeout_sec)

    def _nav2_online(self):
        if not self.nav_to_pose_client.wait_for_server(timeout_sec=0.05):
            return False

        active_nodes = {name.lstrip('/') for name in self.get_node_names()}
        missing_nodes = self.required_nav2_nodes - active_nodes
        if missing_nodes:
            self.get_logger().debug('Nav2 action server exists, waiting for nodes: %s' % sorted(missing_nodes))
            return False
        return True

    def _select_audio(self):
        if self._audio_file_exists(self.started_audio):
            return self.started_audio
        self.get_logger().warn('Feedback audio %s is missing; fallback to %s.' %
                               (self.started_audio, self.fallback_audio))
        return self.fallback_audio

    def _audio_file_exists(self, audio_file):
        if not self.audio_path:
            return True
        return os.path.exists(os.path.join(self.audio_path, audio_file.lstrip('/')))

    def _publish_feedback(self, audio_file):
        msg = String()
        msg.data = audio_file
        self.feedback_pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    node = Nav2StartFeedbackMonitor()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
