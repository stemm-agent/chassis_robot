        self._active_navigation_start_started_at_monotonic = 0.0
        self._follow_voice_request_token = 0
        self._follow_feedback_completed_token = 0
        self._follow_feedback_pending = None
        self._follow_status_future = None
        self._follow_status_future_token = 0
        self._follow_status_next_poll = 0.0

        self.recharge_start_client = self.create_client(
            Trigger, self.recharge_start_service
        )
        self.recharge_stop_client = self.create_client(
            Trigger, self.recharge_stop_service
        )
        self.follow_control_client = self.create_client(
            SetBool, self.bodyfollow_mode_service
        )
        self.follow_status_client = self.create_client(
            Trigger, self.bodyfollow_status_service
        )
        self.navigation_lifecycle_clients = {
            service_name: self.create_client(
                ManageLifecycleNodes, service_name)
            for service_name in self.navigation_lifecycle_manager_services
        }
        navigation_event_qos = QoSProfile(
            depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.feedback_pub = self.create_publisher(String, 'feedback_audio', 10)
        self.navigation_start_event_pub = self.create_publisher(
            String, self.navigation_start_event_topic, navigation_event_qos)
        self.voice_sub = self.create_subscription(
            String, 'voice_words', self._voice_words_callback, 10
        )
        self.navigation_start_result_sub = self.create_subscription(
            String,
            self.navigation_start_result_topic,
            self._navigation_start_result_callback,
            10,
        )
        self.create_subscription(
            Bool,
            '/stemm_cartographer/motion_blocked',
            self._mapping_motion_blocked_callback,
            10,
        )
        # Keep a recent dock-state hint in this long-lived node.  A freshly
        # spawned cancel node can otherwise miss volatile chassis topics while
        # DDS discovery is still converging.
        self.create_subscription(
            Bool, 'robot_charging_flag', self._charging_state_callback, 10
        )
        self.create_subscription(
            Float32, 'robot_charging_current', self._charging_current_callback, 10
        )
        self.create_subscription(UInt8, 'robot_red_flag', self._red_state_callback, 10)
        self.create_timer(1.0, self._reap_finished_processes)
        self.create_timer(0.5, self._check_navigation_start_timeout)
        self.create_timer(
            self.follow_feedback_poll_sec, self._check_follow_feedback)

        self.get_logger().info(
            'voice_recharge_bridge ready: start=%s cancel=%s navigation=%s follow=%s cancel_navigation=%s cancel_follow=%s dry_run=%s'
            % (
                sorted(self.start_commands),
                sorted(self.cancel_commands),
                sorted(self.navigation_commands),
                sorted(self.follow_commands),
                sorted(self.cancel_navigation_commands),
                sorted(self.cancel_follow_commands),
                self.dry_run,
            )
        )

    def _voice_words_callback(self, msg):
        command = msg.data.strip()
        if not command:
            return

        if command in self.start_commands:
            if self._in_cooldown(command):
                return
            self._start_recharge()
        elif command in self.cancel_commands:
            if self._in_cooldown(command):
                return
            self._cancel_recharge()
        elif command in self.navigation_commands:
            if self._in_cooldown(command):
                return
            self._start_navigation()
        elif command in self.follow_commands:
            if self._in_cooldown(command):
                return
            self._start_follow()
        elif command in self.cancel_navigation_commands:
            if self._in_cooldown(command):
                return
            self._cancel_navigation()
        elif command in self.cancel_follow_commands:
            if self._in_cooldown(command):
                return
            self._cancel_follow()

    def _in_cooldown(self, command):
        now = time.monotonic()
        last = self._last_command_at.get(command, 0.0)
        if now - last < self.command_cooldown_sec:
            self.get_logger().info('Ignore repeated voice command within cooldown: %s' % command)
            return True
        self._last_command_at[command] = now
        return False

    def _remember_dock_evidence(self):
        self._dock_evidence_until = max(
            self._dock_evidence_until,
            time.monotonic() + self.dock_evidence_hold_sec,
        )

    # ==== 里程计跟踪与播种（2026-09-13） ====
    def _odom_callback(self, msg):
        q = msg.pose.pose.orientation
        yaw = math.atan2(2.0 * (q.w * q.z + q.x * q.y),
                         1.0 - 2.0 * (q.y * q.y + q.z * q.z))
        new_odom = (msg.pose.pose.position.x, msg.pose.pose.position.y, yaw)
        self._odom_samples_seen += 1
        self._check_anchor_epoch(new_odom)
        # ---- B: an odometry jump or reset makes every stored anchor meaningless ----
        if self._odom_last is not None:
            step = math.hypot(
                new_odom[0] - self._odom_last[0], new_odom[1] - self._odom_last[1])
            prev_norm = math.hypot(self._odom_last[0], self._odom_last[1])
            new_norm = math.hypot(new_odom[0], new_odom[1])
            if step > self.odom_jump_max_m:
                self._odom_jumps += 1
                self._invalidate_anchor(
                    'odometry jump of %.3fm (limit %.2fm)' % (step, self.odom_jump_max_m))
            elif (prev_norm > self.odom_reset_min_prev_m and
                  new_norm < self.odom_reset_radius_m):
                self._odom_jumps += 1
                self._invalidate_anchor(
                    'odometry reset (|p| %.2fm -> %.2fm)' % (prev_norm, new_norm))
        self._odom_last = new_odom
        self._odom = new_odom
        if not self._undock_tracking or self._odom_at_dock is None:
            return
        previous = self._undock_last_odom
        self._undock_last_odom = self._odom
        start = self._undock_start_odom or self._odom_at_dock
        travelled = math.hypot(self._odom[0] - start[0], self._odom[1] - start[1])
        self._undock_last_distance_m = travelled
        if previous is None:
            return
        step = math.hypot(self._odom[0] - previous[0], self._odom[1] - previous[1])
        now = time.monotonic()
        if step > self.undock_still_eps_m:
            self._undock_still_since = None
            return
        if self._undock_still_since is None:
            self._undock_still_since = now
            return
        if now - self._undock_still_since < self.undock_still_sec:
            return
        if travelled < self.undock_min_travel_m:
            return
        if travelled > self.undock_max_travel_m:
            # 行程过大：这不是刚脱桩后的小幅前进（例如标志抖动后车已经开出很远），
            # 不能把它当成地图原点，交回桩位兜底或直接拒绝。
            self._undock_tracking = False
            self.get_logger().warn(
                'Ignoring a standstill %.2fm after the dock contact: outside the '
                'plausible undock range [%.2f, %.2f]m; the recharge point is not '
                're-anchored.' % (travelled, self.undock_min_travel_m,
                                  self.undock_max_travel_m))
            return
        self._odom_at_recharge_point = self._odom
        self._anchor_valid = True
        self._odom_epoch_gids = self._odom_publisher_gids()
        self._undock_tracking = False
        self.get_logger().info(
            'Recharge point anchored at odom %s (undock travel %.3fm). '
            'This pose is the map origin.' % (self._odom, travelled))
        try:
            self._save_anchor('undock standstill')
        except Exception as exc:                     # never let bookkeeping kill the bridge
            self.get_logger().warn('Anchor save (undock) failed: %s' % exc)
    # ==== 2026-09-15 (A/B): anchor persistence and odometry validation ====
    def _anchor_snapshot(self, reason):
        return {
            'saved_at': time.time(),
            'reason': reason,
            'odom_at_dock': list(self._odom_at_dock) if self._odom_at_dock else None,
            'odom_at_recharge_point': (
                list(self._odom_at_recharge_point) if self._odom_at_recharge_point else None),
            'undock_last_distance_m': float(self._undock_last_distance_m),
            'recharge_point': list(self.recharge_point),
            'odom_now': list(self._odom) if self._odom else None,
            'anchor_valid': bool(self._anchor_valid),
            'odom_publisher_gids': list(self._odom_epoch_gids
                                        or self._odom_publisher_gids()),
        }

    def _save_anchor(self, reason):
        if not self.anchor_restore_enabled or self._odom is None or not self._anchor_valid:
            return
        if self._odom_at_dock is None and self._odom_at_recharge_point is None:
            return
        # /robot_charging_flag is a high-rate topic: the dock-contact path calls
        # this on every message, which used to rewrite the anchor file (and log)
        # about 20 times per second while docked.  Persist only a real change.
        now = time.time()
        previous = getattr(self, '_anchor_last_saved', None)
        if previous is not None:
            same_reason = previous.get('reason') == reason
            moved = math.hypot(
                self._odom[0] - previous['odom'][0],
                self._odom[1] - previous['odom'][1])
            dyaw = (self._odom[2] - previous['odom'][2] + math.pi) % (2.0 * math.pi) - math.pi
            if self.has_parameter('anchor_resave_interval_s'):
                resave_interval_s = float(
                    self.get_parameter('anchor_resave_interval_s').value)
            else:
                try:
                    resave_interval_s = float(self.declare_parameter(
                        'anchor_resave_interval_s', 30.0).value)
                except Exception:
                    resave_interval_s = 30.0
            if (same_reason and moved < 0.05 and abs(dyaw) < 0.05 and
                    now - previous['at'] < max(0.0, resave_interval_s)):
                return
        try:
            snap = self._anchor_snapshot(reason)
        except Exception as exc:                     # never let bookkeeping kill the bridge
            self.get_logger().warn('Anchor snapshot failed: %s' % exc)
            return
        try:
            directory = os.path.dirname(self.anchor_state_path)
            if directory:
                os.makedirs(directory, exist_ok=True)
            tmp_path = self.anchor_state_path + '.tmp'
            with open(tmp_path, 'w') as handle:
                json.dump(snap, handle)
            os.replace(tmp_path, self.anchor_state_path)
            self._anchor_last_saved = {
                'reason': reason, 'odom': tuple(self._odom), 'at': now}
            self.get_logger().info(
                'Anchor saved (%s) -> %s: recharge=%s dock=%s' % (
                    reason, self.anchor_state_path,
                    snap['odom_at_recharge_point'], snap['odom_at_dock']))
        except OSError as exc:
            self.get_logger().warn('Could not save the localization anchor: %s' % exc)

    def _load_anchor(self):
        if not self.anchor_restore_enabled:
            return
        path = self.anchor_state_path
        if not path or not os.path.exists(path):
            self.get_logger().info('No saved localization anchor at %s' % path)
            return
        try:
            with open(path) as handle:
                snap = json.load(handle)
        except Exception as exc:
            self.get_logger().warn('Unreadable localization anchor (%s); ignoring it' % exc)
            return
        age = max(0.0, time.time() - float(snap.get('saved_at') or 0.0))
        if self.anchor_max_age_s > 0.0 and age > self.anchor_max_age_s:
            self.get_logger().warn(
                'Saved anchor is %.0fs old (> %.0fs); ignoring it' % (age, self.anchor_max_age_s))
            return
        if not bool(snap.get('anchor_valid', True)):
            self.get_logger().warn('Saved anchor was marked invalid; ignoring it')
            return
        saved_point = snap.get('recharge_point')
        if saved_point is not None and tuple(saved_point) != tuple(self.recharge_point):
            self.get_logger().warn(
                'Saved anchor used recharge point %s (current %s); ignoring it' % (
                    saved_point, list(self.recharge_point)))
            return
        restored = None
        recharge = snap.get('odom_at_recharge_point')
        dock = snap.get('odom_at_dock')
        if recharge is not None:
            self._odom_at_recharge_point = tuple(float(v) for v in recharge)
            restored = 'recharge point'
        elif dock is not None:
            self._odom_at_dock = tuple(float(v) for v in dock)
            restored = 'dock contact'
        if restored is None:
            self.get_logger().warn('Saved anchor contains no usable pose; ignoring it')
            return
        if snap.get('undock_last_distance_m') is not None:
            self._undock_last_distance_m = float(snap['undock_last_distance_m'])
        self._anchor_restored_from = path
        self._anchor_restored_age_s = float(age)
        self._odom_epoch_gids = tuple(snap.get('odom_publisher_gids') or ())
        self._anchor_restored_at_wall = time.time()
        self._anchor_epoch_checked = False
        self.get_logger().info(
            'Localization anchor restored from %s (age %.0fs, source %s, reason=%s): '
            'recharge=%s dock=%s -> navigation can start without docking again.' % (
                path, age, restored, snap.get('reason'),
                self._odom_at_recharge_point, self._odom_at_dock))

    def _invalidate_anchor(self, reason):
        if not getattr(self, '_anchor_valid', True):
            return
        self._anchor_valid = False
        self._anchor_invalid_reason = str(reason)
        # 2026-09-23 (guard 1): a void correspondence must not be reusable later.
        self._odom_at_recharge_point = None
        self._odom_at_dock = None
        self._anchor_restored_from = ''
        self._anchor_restored_age_s = -1.0
        try:
            if os.path.exists(self.anchor_state_path):
                os.remove(self.anchor_state_path)
        except OSError:
            pass
        self.get_logger().error(
            'Localization anchor invalidated: %s. A fresh dock/undock anchor is required '
            'before navigation can start.' % reason)

    # ==== 2026-09-23: seed trust guards ====
    def _anchor_odom_reference(self):
        """Odometry pose the current anchor corresponds to, or None."""
        if self._odom_at_recharge_point is not None:
            return self._odom_at_recharge_point
        if self._odom_at_dock is not None:
            return self._odom_at_dock
        return None

    def _check_anchor_epoch(self, odom):
        """Guard (1): void the anchor when the odometry session has restarted.

        /odom_combined re-zeroes whenever the stack (ekf_filter_node) restarts, so an
        anchor recorded in a previous session can never be reproduced.  Refusing the
        seed is the safe answer; only a dock contact re-anchors, because the charger
        is the one absolute reference in the map.
        """
        if not self.odom_epoch_guard_enabled or self._anchor_epoch_checked:
            return
        reference = self._anchor_odom_reference()
        if reference is None:
            return                      # nothing restored yet: check on a later tick
        self._anchor_epoch_checked = True
        anchor_norm = math.hypot(reference[0], reference[1])
        odom_norm = math.hypot(odom[0], odom[1])
        if anchor_norm < self.odom_restart_min_anchor_m:
            return                      # too close to the origin to tell apart
        if odom_norm > self.odom_restart_radius_m:
            return                      # the odometry session survived: keep it
        self.get_logger().error(
            'Odometry session appears to have restarted: |odom| was %.2fm when the '
            'anchor was recorded and is %.2fm now, so the stored odom<->map '
            'correspondence is void.' % (anchor_norm, odom_norm))
        self._invalidate_anchor(
            'odometry restart since the anchor was recorded (|odom| %.2fm -> %.2fm)'
            % (anchor_norm, odom_norm))

    def _odom_publisher_gids(self):
        """GIDs of the current /odom_combined publishers (the odometry epoch id).

        A new GID means the odometry node restarted, so its pose origin is new and any
        stored odom<->map correspondence is void.  Returns () when the graph is not
        ready, in which case the caller must not invalidate anything.
        """
        try:
            infos = self.get_publishers_info_by_topic('/odom_combined')
        except Exception:
            return ()
        gids = []
        for info in infos:
            try:
                gids.append(bytes(info.endpoint_gid).hex())
            except Exception:
                continue
        return tuple(sorted(gids))

    def _check_odom_epoch(self):
        """Guard (1, precise): void the anchor when the odometry publisher changed."""
        if not self.odom_epoch_guard_enabled or not self._anchor_valid:
            return
        if self._anchor_odom_reference() is None:
            return
        current = self._odom_publisher_gids()
        if not current:
            return                      # graph not ready: never invalidate on unknown
        if not self._odom_epoch_gids:
            # First moment the graph is visible in this process (an anchor captured
            # before discovery finished has no baseline yet): adopt it.
            self._odom_epoch_gids = current
            return
        if set(current).isdisjoint(set(self._odom_epoch_gids)):
            recorded = ','.join(g[:8] for g in self._odom_epoch_gids)
            now = ','.join(g[:8] for g in current)
            self._odom_epoch_gids = current
            self.get_logger().error(
                'Odometry publisher changed (%s -> %s): the odometry session restarted, '
                'so the stored odom<->map correspondence is void.' % (recorded, now))
            self._invalidate_anchor(
                'odometry publisher restarted (%s -> %s)' % (recorded, now))

    def _map_callback(self, msg):
        self._map_msg = msg
        self._map_at = time.monotonic()

    def _map_cell(self, x, y):
        """OccupancyGrid value at (x, y) in the map frame, or None when outside."""
        msg = self._map_msg
        if msg is None:
            return None
        info = msg.info
        if info.resolution <= 0.0:
            return None
        col = int(math.floor((x - info.origin.position.x) / info.resolution))
        row = int(math.floor((y - info.origin.position.y) / info.resolution))
        if col < 0 or row < 0 or col >= info.width or row >= info.height:
            return None
        index = row * info.width + col
        if index < 0 or index >= len(msg.data):
            return None
        return int(msg.data[index])

    def _validate_seed_pose(self, x, y):
        """Guard (2): reject a seed that contradicts the map or dock evidence.

        Returns a reason string when the seed must be refused, else None.
        """
        if self.seed_dock_consistency_enabled and self._has_recent_dock_evidence():
            limit = self.seed_dock_max_distance_m + max(
                self.dock_offset_distance_m, self.undock_min_travel_m)
            away = math.hypot(x - self.recharge_point[0], y - self.recharge_point[1])
            if away > limit:
                return ('dock/charging evidence says the robot is on the charger '
                        '(within %.2fm of the recharge point) but the candidate seed '
                        '(%.2f, %.2f) is %.2fm away' % (limit, x, y, away))
        if not self.seed_map_check_enabled:
            return None
        if self._map_msg is None:
            if self.seed_map_require_available:
                return ('no %s received yet, so the candidate seed (%.2f, %.2f) cannot '
                        'be checked against the map' % (self.seed_map_topic, x, y))
            if not self._map_missing_warned:
                self._map_missing_warned = True
                self.get_logger().warn(
                    'No %s received yet; seeding (%.2f, %.2f) without the map check. '
                    'This is expected when navigation is started from the voice path, '
                    'which seeds before nav2 map_server exists.'
                    % (self.seed_map_topic, x, y))
            return None
        cell = self._map_cell(x, y)
        if cell is None:
            return ('candidate seed (%.2f, %.2f) is outside the map' % (x, y))
        if cell < 0:
            if self.seed_map_allow_unknown:
                return None
            return ('candidate seed (%.2f, %.2f) lands in unknown map space' % (x, y))
        if cell > self.seed_map_max_occupied:
            return ('candidate seed (%.2f, %.2f) lands on an occupied cell (value %d)'
                    % (x, y, cell))
        return None

    def _amcl_pose_callback(self, msg):
        # AMCL 已开始输出位姿 => 播种生效，停止重复播种
        # 2026-09-23: /amcl_pose is latched, so a restarted bridge receives the pose of
        # a *previous* AMCL instance immediately.  Only a pose that answers a seed we
        # really published may retire the auto-seed; otherwise a bridge restart silently
        # never re-seeds a nav2 that is already running (observed: a stale x=10.18 pose
        # survived every mic restart, so the seed guards could not engage).
        if self._seed_msg is not None:
            self.get_logger().info(
                'AMCL pose received; initial pose applied once, AMCL now converges '
                'on its own.')
            self._seed_msg = None
            self._seed_applied = True
            self._auto_seed_done_for_instance = True
            self._auto_seed_active = False
        self._record_seed_estimate(msg)
    # ==== 2026-09-15 (C/D): seed acceptance verdict and global-localization fallback ====
    def _record_seed_estimate(self, msg):
        if self._seed_expected is None:
            return
        ex, ey, _ = self._seed_expected
        ax = msg.pose.pose.position.x
        ay = msg.pose.pose.position.y
        error = math.hypot(ax - ex, ay - ey)
        self._seed_estimate_error_m = error
        elapsed = time.monotonic() - self._seed_expected_at
        if error <= self.seed_accept_max_error_m:
            if not self._seed_accepted:
                self._seed_accepted = True
                self._seed_accept_elapsed_s = elapsed
                self.get_logger().info(
                    'Seed accepted: AMCL pose (%.3f, %.3f) is %.3fm from the seeded pose '
                    '(tolerance %.2fm) after %.1fs.'
                    % (ax, ay, error, self.seed_accept_max_error_m, elapsed))
        elif elapsed > self.seed_accept_grace_s:
            self.get_logger().warn(
                'AMCL pose (%.3f, %.3f) is still %.3fm from the seeded pose after '
                '%.1fs; scan matching has not converged to the expected place.'
                % (ax, ay, error, elapsed))

    def _check_seed_acceptance(self):
        if self._seed_expected is None or self._seed_accepted:
            return
        elapsed = time.monotonic() - self._seed_expected_at
        if elapsed < self.seed_accept_timeout_s:
            return
        self._seed_accepted = True     # one-shot: stop re-checking this seed
        self._seed_failures += 1
        self.get_logger().error(
            'Seed acceptance failed: no /amcl_pose within %.1fs of the seeded pose '
            '(%.3f, %.3f). Localization did not start where the anchor predicted.'
            % (self.seed_accept_timeout_s, self._seed_expected[0], self._seed_expected[1]))
        self._request_global_localization()

    def _global_localization_candidates(self):
        names = [self.global_localization_service, self.global_localization_service_fallback]
        return [n for i, n in enumerate(names) if n and n not in names[:i]]

    def _request_global_localization(self):
        if not self.global_localization_on_failure:
            return
        candidates = self._global_localization_candidates()
        ready = [n for n in candidates
                 if self._global_localization_client.service_is_ready()]
        for name in candidates:
            if name in ready:
                continue
            probe = self.create_client(EmptySrv, name)
            if probe.service_is_ready() or probe.wait_for_service(timeout_sec=1.0):
                ready.append(name)
        if not ready:
            self.get_logger().warn(
                'Global localization services %s are not available; a fresh dock/undock '
                'anchor is required before navigation can start.' % candidates)
            return
        target = self.create_client(EmptySrv, ready[0])
        if not (target.service_is_ready() or target.wait_for_service(timeout_sec=1.0)):
            self.get_logger().warn('Global localization service %s vanished.' % ready[0])
            return
        target.call_async(EmptySrv.Request())
        self._global_localization_requests += 1
        self.get_logger().warn(
            'Requested a global localization from AMCL (uniform particle distribution, '
            '%s); convergence needs motion.' % ready[0])

    @staticmethod
    def _wrap_angle(value):
        while value > math.pi:
            value -= 2.0 * math.pi
        while value < -math.pi:
            value += 2.0 * math.pi
        return value

    def _compute_seed_pose(self):
        """返回 (x, y, yaw, sigma_xy, sigma_yaw, source)；不可信时 x 为 None。

        锚点优先级：
          1) 脱桩停稳处 —— 按定义就是回充点，也就是地图原点；
          2) 充电接触位姿 —— 只在没见过脱桩停稳时兜底，桩位 = 回充点后方一个脱桩行程。
        两者都用里程计位移外推，里程计被视为可信的短时位移源。
        """
        if self._odom is None:
            return None, None, None, None, None, 'no /odom_combined received'
        if not self._anchor_valid:
            return (None, None, None, None, None,
                    'anchor invalidated (%s; %d odometry jump(s) seen)' %
                    (self._anchor_invalid_reason or 'reason not recorded',
                     self._odom_jumps))
        # Guard (3): an anchor restored from disk belongs to an earlier odometry
        # session; it is only trusted for a limited time after it was saved.
        if self.seed_restored_anchor_max_age_s > 0.0 and self._anchor_restored_from:
            restored_age = self._anchor_restored_age_s + max(
                0.0, time.time() - self._anchor_restored_at_wall)
            if restored_age > self.seed_restored_anchor_max_age_s:
                return (None, None, None, None, None,
                        'the anchor restored from %s is %.0fs old (> %.0fs); it is no '
                        'longer trusted after a restart, dock the robot (charging '
                        'contact) to re-anchor' % (
                            self._anchor_restored_from, restored_age,
                            self.seed_restored_anchor_max_age_s))
        if self._odom_at_recharge_point is not None:
            ax, ay, ayaw = self._odom_at_recharge_point
            bx, by, byaw = self.recharge_point
            source = 'recharge point (map origin)'
        elif self._odom_at_dock is not None:
            # 只有“达到最小脱桩行程”的实测值才可信：充电标志抖动会让追踪刚起步
            # （位移≈0）而机器人其实早已离开桩位，此时必须用配置的兜底行程。
            travel = (self._undock_last_distance_m
                      if self._undock_last_distance_m >= self.undock_min_travel_m
                      else self.dock_offset_distance_m)
            rx, ry, ryaw = self.recharge_point
            ax, ay, ayaw = self._odom_at_dock
            bx = rx - math.cos(ryaw) * travel
            by = ry - math.sin(ryaw) * travel
            byaw = ryaw
            source = ('dock contact %.3fm behind the recharge point' % travel)
        else:
            return (None, None, None, None, None,
                    'no dock contact and no completed undock observed this session')
        mx, my = self._odom[0] - ax, self._odom[1] - ay
        myaw = self._wrap_angle(self._odom[2] - ayaw)
        dist = math.hypot(mx, my)
        if dist > self.seed_max_dead_reckoning_m:
            return None, None, None, None, None, (
                'dead-reckoning distance %.1fm exceeds %.1fm (odom reset?)'
                % (dist, self.seed_max_dead_reckoning_m))
        c, s = math.cos(byaw), math.sin(byaw)
        x = bx + c * mx - s * my
        y = by + s * mx + c * my
        yaw = self._wrap_angle(byaw + myaw)
        verdict = self._validate_seed_pose(x, y)
        if verdict is not None:
            return (None, None, None, None, None, verdict)
        return (x, y, yaw,
                self.seed_sigma_xy + self.seed_sigma_per_m * dist,
                self.seed_sigma_yaw,
                '%s + %.3fm dead reckoning' % (source, dist))
    def _begin_seeding(self, label):
        """构造并开始投递初值；失败返回 False（不发布拒绝事件，由调用方决定怎么报）。"""
        x, y, yaw, sigma_xy, sigma_yaw, source = self._compute_seed_pose()
        if x is None:
            self.get_logger().error(
                'Refusing to seed localization (%s): %s' % (label, source))
            return False
        msg = PoseWithCovarianceStamped()
        msg.header.frame_id = 'map'
        msg.pose.pose.position.x = x
        msg.pose.pose.position.y = y
        msg.pose.pose.orientation.z = math.sin(yaw / 2.0)
        msg.pose.pose.orientation.w = math.cos(yaw / 2.0)
        cov = [0.0] * 36
        cov[0] = cov[7] = sigma_xy * sigma_xy
        cov[35] = sigma_yaw * sigma_yaw
        msg.pose.covariance = cov
        self._seed_msg = msg
        self._seed_deadline = time.monotonic() + self.seed_repeat_max_sec
        self._seed_applied = False
        self._seed_publishes = 0
        self._seed_expected = (x, y, yaw)
        self._seed_expected_at = time.monotonic()
        self._seed_accepted = False
        self._seed_estimate_error_m = None
        self.get_logger().info(
            'Localization seed prepared (%s): x=%.3f y=%.3f yaw=%.1fdeg sigma=%.3f/%.3f (%s)'
            % (label, x, y, math.degrees(yaw), sigma_xy, sigma_yaw, source))
        self._publish_seed_now()
        return True

    def _amcl_online(self):
        """AMCL 在线判据：nomotion 服务可用（节点名发现这套 DDS 下不可靠，实测服务可靠）。"""
        try:
            return self._nomotion_client.service_is_ready()
        except Exception:
            return False

    def _watch_amcl_instance(self):
        """兜底播种：非语音入口（web/MQTT、多机、CLI）拉起 nav2 时也要有初值。

        桥是常驻的、锚点也在这里，所以在检测到新的 AMCL 实例时由它播一次；
        语音"开启导航"路径会自己播种，这里只在没有播种在飞时兜底，
        且同一个 AMCL 实例确认到位后不再重复播种。
        """
        if not self.auto_seed_on_amcl_start:
            return
        now = time.monotonic()
        if not self._amcl_online():
            if self._amcl_online_state:
                self._amcl_online_state = False
                self._amcl_absent_since = now
            elif (self._amcl_absent_since is not None
                  and now - self._amcl_absent_since >= self.auto_seed_min_absence_sec):
                # 离开足够久 => 下次出现按新实例处理
                self._auto_seed_done_for_instance = False
                self._auto_seed_active = False
                self._amcl_absent_since = None
            return
        self._amcl_absent_since = None
        if not self._amcl_online_state:
            self._amcl_online_state = True
            if not self._auto_seed_done_for_instance:
                self._auto_seed_active = True
                self.get_logger().info(
                    'AMCL instance detected: nav2 started outside the voice path also '
                    'needs an initial pose; seeding from the dock/recharge anchor.')
        if not self._auto_seed_active or self._seed_msg is not None:
            return
        # 2026-09-15 (C8): a bridge restart can see AMCL before the first /odom_combined
        # arrives. That is transient: keep the auto-seed pending instead of latching it
        # off for this AMCL instance (which used to leave a fresh AMCL unseeded).
        if self._odom is None:
            self.get_logger().warn(
                'AMCL is online but /odom_combined has not arrived yet; keeping the '
                'auto-seed pending for the next tick.')
            return
        if not self._begin_seeding('auto: new AMCL instance'):
            self._auto_seed_active = False
            self.get_logger().error(
                'AMCL is online but no trustworthy anchor exists, so navigation cannot '
                'localize. Put the robot on the dock (charging contact), or publish '
                '/initialpose manually.')

    def _seed_localization_before_start(self, generation):
        if self._begin_seeding('navigation start generation %d' % generation):
            self._auto_seed_active = False
            return True
        _, _, _, _, _, source = self._compute_seed_pose()
        detail = ('本地化初值不可信：%s；请先让小车在充电桩上（充电接触）再开启导航' % source)
        self.get_logger().error(detail)
        self._publish_navigation_start_rejection(generation, detail)
        return False
    def _publish_seed_now(self):
        if self._seed_msg is None:
            return
        self._seed_msg.header.stamp = self.get_clock().now().to_msg()
        self.initialpose_pub.publish(self._seed_msg)
        self._seed_publishes += 1

    def _seed_timer_callback(self):
        self._check_odom_epoch()
        """先把"是否有新 AMCL 实例需要兜底播种"处理掉，再投递待发的初值。"""
        self._watch_amcl_instance()
        self._check_seed_acceptance()
        if self._seed_msg is None:
            return
        if self._seed_publishes >= self.seed_max_publishes:
            self.get_logger().warn(
                'Seed sent %d times without an AMCL pose confirmation; stopping so '
                'that AMCL is not re-initialized repeatedly. If localization is dead, '
                'check /amcl and the map.' % self._seed_publishes)
            self._seed_msg = None
            return
        # AMCL 静止时不做滤波更新，/amcl_pose 可能永远不来；用官方 nomotion 服务催更
        now_mono = time.monotonic()
        if now_mono - self._nomotion_last_call > 2.0:
            self._nomotion_last_call = now_mono
            if self._nomotion_client.service_is_ready():
                self._nomotion_client.call_async(EmptySrv.Request())
                self.get_logger().info('Requested a nomotion update from AMCL.')
        self._publish_seed_now()
    def _charging_state_callback(self, msg):
        charging = bool(msg.data)
        previous = self._charging_state
        self._charging_state = charging
        if charging:
            # 充电接触 = 绝对真值：记录里程计基准（该话题高频发布，只在翻转时记日志）
            self._odom_at_dock = self._odom
            self._anchor_valid = True
            self._remember_dock_evidence()
            try:
                self._save_anchor('dock contact')
            except Exception as exc:                 # never let bookkeeping kill the bridge
                self.get_logger().warn('Anchor save (dock) failed: %s' % exc)
            self._undock_tracking = False
            self._odom_at_recharge_point = None
            # 2026-09-23: the charger is ground truth for the map origin, so a dock
            # contact re-anchors from the live odometry and retires any anchor that
            # was restored from disk (guards 1 and 3).
            self._anchor_restored_from = ''
            self._anchor_restored_age_s = -1.0
            self._anchor_invalid_reason = ''
            self._odom_epoch_gids = self._odom_publisher_gids()
            if not self._dock_contact_logged:
                self._dock_contact_logged = True
                self.get_logger().info(
                    'Dock contact confirmed; odom anchor captured: %s' % (self._odom,))
            return
        self._dock_contact_logged = False
        # 只有"在桩 -> 离开桩"这一次真跳变才算脱桩开始；之后持续为 False 的每一帧
        # 都不能重新开一次追踪（否则会把车开出去后随便一次停稳当成地图原点）。
        if previous is True and self._odom_at_dock is not None and not self._undock_tracking:
            self._undock_tracking = True
            self._undock_start_odom = self._odom
            self._undock_last_odom = self._odom
            self._undock_still_since = None
            self._odom_at_recharge_point = None
            self._undock_last_distance_m = 0.0
            self.get_logger().info(
                'Undock started; the standstill after it will be anchored as the '
                'recharge point (map origin).')
    def _charging_current_callback(self, msg):
        if float(msg.data) > 0.05:
            self._remember_dock_evidence()

    def _red_state_callback(self, msg):
        if int(msg.data) > 0:
            self._remember_dock_evidence()

    def _has_recent_dock_evidence(self):
        return time.monotonic() <= self._dock_evidence_until

    def _mapping_motion_blocked_callback(self, msg):
        blocked = bool(msg.data)
        if blocked and not self._mapping_motion_blocked:
            self.get_logger().warn(
                'Cartographer mapping gate active; block recharge, normal '
                'navigation, and body-follow start commands.')
        self._mapping_motion_blocked = blocked

    def _reject_mapping_motion(self, action):
        if not self._mapping_motion_blocked:
            return False
        self.get_logger().warn(
            'Reject %s while Cartographer mapping owns motion.' % action)
        self._publish_feedback('/stop.wav')
        return True

    def _start_recharge(self):
        if self._reject_mapping_motion('recharge start'):
            return
        self._publish_feedback('/OK.wav')
        if self.dry_run:
            self.get_logger().info(
                'Dry run: would call recharge manager service %s'
                % self.recharge_start_service
            )
            return
        if (
            self._recharge_start_future is not None
            and not self._recharge_start_future.done()
        ):
            self.get_logger().warn(
                'Recharge start request is already pending; ignore duplicate command.'
            )
            return
        if not (
            self.recharge_start_client.service_is_ready()
            or self.recharge_start_client.wait_for_service(timeout_sec=0.5)
        ):
            self.get_logger().error(
                'Persistent recharge manager service is unavailable: %s'
                % self.recharge_start_service
            )
            return
        self._recharge_start_future = self.recharge_start_client.call_async(
            Trigger.Request()
        )
        self._recharge_start_future.add_done_callback(
            self._recharge_start_response
        )

    def _recharge_start_response(self, future):
        self._recharge_start_future = None
        try:
            response = future.result()
        except Exception as exc:
            self.get_logger().error('Recharge manager start request failed: %s' % exc)
            return
        if response is not None and response.success:
            self.get_logger().info('Recharge manager accepted voice request: %s' % response.message)
        else:
            self.get_logger().warn(
                'Recharge manager rejected voice request: %s'
                % (response.message if response is not None else 'empty response')
            )

    def _request_manager_stop_fallback(self):
        if not (
            self.recharge_stop_client.service_is_ready()
            or self.recharge_stop_client.wait_for_service(timeout_sec=0.5)
        ):
            self.get_logger().error(
                'Recharge manager stop service is unavailable: %s'
                % self.recharge_stop_service
            )
            return
        self._recharge_stop_future = self.recharge_stop_client.call_async(
            Trigger.Request()
        )
        self._recharge_stop_future.add_done_callback(
            self._recharge_stop_response
        )

    def _recharge_stop_response(self, future):
        self._recharge_stop_future = None
        try:
            response = future.result()
        except Exception as exc:
            self.get_logger().error('Recharge manager stop request failed: %s' % exc)
            return
        if response is not None and response.success:
            self.get_logger().info('Recharge manager stop confirmed: %s' % response.message)
        else:
            self.get_logger().warn(
                'Recharge manager stop was not confirmed: %s'
                % (response.message if response is not None else 'empty response')
            )

    def _cancel_recharge(self):
        self._publish_feedback('/OK.wav')
        self._reap_finished_processes()
        if self._is_tracked_process_running('cancel_charge'):
            self.get_logger().warn(
                'Cancel-charge process is already running; ignore duplicate cancel command.'
            )
            return

        dock_hint = self._has_recent_dock_evidence()
        self.get_logger().info('Cancel recharge with cached dock_hint=%s.' % dock_hint)
        launched = self._launch_ros2_run(
            self.cancel_executable,
            'cancel_charge',
            ros_args=['--ros-args', '-p', 'dock_hint:=%s' % str(dock_hint).lower()],
        )
        if launched is not None:
            self._child_processes.append(('cancel_charge',) + launched)
            self._cancel_recharge_deadline = (
                time.monotonic() + self.cancel_recharge_timeout_sec
            )
            self.get_logger().info(
                'Cancel-charge owns the graceful shutdown; force cleanup is deferred for %.1fs.'
                % self.cancel_recharge_timeout_sec
            )
            return

        self.get_logger().error(
            'Failed to launch cancel_charge; falling back to recharge manager stop service.'
        )
        self._request_manager_stop_fallback()

    def _next_navigation_start_generation(self):
        self._navigation_start_generation += 1
        return self._navigation_start_generation

    def _publish_navigation_start_event(self, event, generation, detail=''):
        published_at_epoch_ms = int(time.time() * 1000)
        published_at_monotonic_ms = int(time.monotonic() * 1000)
        started_at_epoch_ms = published_at_epoch_ms
        started_at_monotonic_ms = published_at_monotonic_ms
        if (
            generation == self._active_navigation_start_generation
            and self._active_navigation_start_started_at_epoch_ms > 0
            and self._active_navigation_start_started_at_monotonic > 0.0
        ):
            started_at_epoch_ms = (
                self._active_navigation_start_started_at_epoch_ms
            )
            started_at_monotonic_ms = int(
                self._active_navigation_start_started_at_monotonic * 1000)
        msg = String()
        msg.data = build_navigation_start_event(
            event,
            generation,
            detail,
            os.getpid(),
            published_at_epoch_ms,
            started_at_epoch_ms,
            published_at_monotonic_ms,
            started_at_monotonic_ms,
        )
        self.navigation_start_event_pub.publish(msg)

    def _publish_navigation_start_rejection(self, generation, detail):
        self._publish_navigation_start_event('rejected', generation, detail)
        if self._active_navigation_start_generation is not None:
            # Keep the accepted in-flight generation as the latched state after
            # reporting this separate rejected command.
            self._publish_navigation_start_event(
                'accepted',
                self._active_navigation_start_generation,
                'previously accepted navigation startup remains active',
            )

    def _clear_active_navigation_start(self):
        self._active_navigation_start_generation = None
        self._active_navigation_start_started_at_epoch_ms = 0
        self._active_navigation_start_started_at_monotonic = 0.0

    def _fail_active_navigation_start(self, detail, publish_feedback=False):
        generation = self._active_navigation_start_generation
        if generation is None:
            return False
        self._publish_navigation_start_event(
            'health_failed', generation, detail)
        self._clear_active_navigation_start()
        if publish_feedback:
            # The normal monitor path publishes this feedback before returning
            # its failed result. This fallback is for a missing/stalled monitor.
            self._publish_feedback('/stop.wav')
        self.get_logger().error(
            'Navigation startup generation %d failed health checks; '
            'clean up its exact launch root: %s' % (generation, detail))
        self._reap_finished_processes()
        if self._is_tracked_process_running('navigation_launch'):
            self._begin_navigation_shutdown()
        return True

    def _check_navigation_start_timeout(self):
        generation = self._active_navigation_start_generation
        started_at = self._active_navigation_start_started_at_monotonic
        if generation is None or started_at <= 0.0:
            return
        elapsed_sec = max(0.0, time.monotonic() - started_at)
        if not navigation_start_timeout_reached(
            elapsed_sec, self.navigation_start_timeout_sec
        ):
            return
        self._fail_active_navigation_start(
            'navigation startup health confirmation timed out after %.1fs'
            % self.navigation_start_timeout_sec,
            publish_feedback=True,
        )

    def _navigation_start_result_callback(self, msg):
        try:
            payload = json.loads(msg.data)
            if not isinstance(payload, dict):
                raise ValueError('navigation startup result must be an object')
            generation = int(payload.get('generation'))
            bridge_pid = int(payload.get('bridgePid'))
            result = str(payload.get('result') or '')
        except (TypeError, ValueError, json.JSONDecodeError) as exc:
            self.get_logger().warn(
                'Ignore malformed navigation startup result: %s' % exc)
            return
        if (
            bridge_pid != os.getpid()
            or generation != self._active_navigation_start_generation
        ):
            return
        elapsed_sec = max(
            0.0,
            time.monotonic()
            - self._active_navigation_start_started_at_monotonic,
        )
        if navigation_start_timeout_reached(
            elapsed_sec, self.navigation_start_timeout_sec
        ):
            self._fail_active_navigation_start(
                'navigation startup health confirmation timed out after %.1fs'
                % self.navigation_start_timeout_sec,
                publish_feedback=True,
            )
            return
        if result == 'ready':
            self._publish_navigation_start_event(
                'completed', generation, 'navigation startup is health-confirmed')
            self._clear_active_navigation_start()
            self.get_logger().info(
                'Navigation startup generation %d is health-confirmed.'
                % generation)
            return
        if result != 'failed':
            return
        self._fail_active_navigation_start(
            str(payload.get('detail') or 'navigation startup health failed'))

    def _acquire_navigation_launch_lock(self):
        if self.navigation_launch_lock_configuration_error:
            self.get_logger().error(
                self.navigation_launch_lock_configuration_error)
            return None
        lock_file, lock_error = acquire_navigation_launch_lock(
            'voice:%s' % os.getpid())
        if lock_file is None:
            self.get_logger().warn(lock_error)
        return lock_file

    def _release_navigation_launch_lock(self):
        lock_file = self._navigation_launch_lock_file
        self._navigation_launch_lock_file = None
        if lock_file is None:
            return
        try:
            if fcntl is not None:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
        except (AttributeError, OSError):
            pass
        self._close_log(lock_file)

    def _start_navigation(self):
        generation = self._next_navigation_start_generation()
        if not self._seed_localization_before_start(generation):
            return
        if self._reject_mapping_motion('normal navigation start'):
            self._publish_navigation_start_rejection(
                generation, 'Cartographer mapping owns motion')
            return
        self._reap_finished_processes()
        if self._navigation_shutdown is not None:
            self.get_logger().warn(
                'Navigation shutdown is still in progress; ignore start command.')
            self._publish_navigation_start_rejection(
                generation, 'navigation shutdown is in progress')
            return
        existing_roots = self._navigation_launch_roots()
        if existing_roots:
            self.get_logger().warn(
                'Exact navigation launch root(s) %s already exist; ignore '
                'duplicate voice command.' % existing_roots)
            self._publish_navigation_start_rejection(
                generation,
                'an exact navigation launch root already exists')
            return
        lock_file = self._acquire_navigation_launch_lock()
        if lock_file is None:
            self._publish_navigation_start_rejection(
                generation,
                'shared navigation launch lock was not acquired')
            return
        launched = self._launch_named_process(
            'navigation_launch',
            [self.ros2_command, 'launch', self.navigation_launch_package, self.navigation_launch_file],
            ['bt_navigator', 'planner_server', 'controller_server', 'waypoint_cycle'],
            [
                'ros2 launch wheeltec_nav2 wheeltec_nav2.launch.py',
                'wheeltec_nav2.launch.py',
                'nav2_container',
            ],
            pass_fds=(lock_file.fileno(),),
        )
        if launched is None:
            self._close_log(lock_file)
            self._publish_navigation_start_rejection(
                generation, 'navigation launch process was not created')
            return
        self._navigation_launch_lock_file = lock_file
        self._active_navigation_start_generation = generation
        self._active_navigation_start_started_at_epoch_ms = int(
            time.time() * 1000)
        self._active_navigation_start_started_at_monotonic = time.monotonic()
        self._publish_feedback('/OK.wav')
        self._publish_navigation_start_event(
            'accepted', generation, 'navigation launch process created')

    def _start_follow(self):
        self._set_body_follow_enabled(True)

    def _cancel_navigation(self):
        self._publish_feedback('/OK.wav')
        if self._active_navigation_start_generation is not None:
            self._publish_navigation_start_event(
                'cancelled',
                self._active_navigation_start_generation,
                'navigation cancellation requested',
            )
            self._clear_active_navigation_start()
        if self.dry_run:
            self.get_logger().info(
                'Dry run: would request Nav2 lifecycle shutdown, then stop the '
                'exact %s/%s launch tree.'
                % (self.navigation_launch_package, self.navigation_launch_file)
            )
            return
        self._begin_navigation_shutdown()

    def _cancel_follow(self):
        self._set_body_follow_enabled(False)

    def _set_body_follow_enabled(self, enabled):
        self._follow_voice_request_token += 1
        request_token = self._follow_voice_request_token
        self._follow_feedback_pending = (
            {
                'token': request_token,
                'generation': None,
                'deadline': time.monotonic()
                + self.follow_feedback_timeout_sec,
            }
            if enabled else None)
        self._follow_status_future = None
        self._follow_status_future_token = 0
        self._follow_status_next_poll = 0.0
        if enabled and self._reject_mapping_motion('body follow enable'):
            # _reject_mapping_motion already publishes the single failure tone.
            self._follow_feedback_completed_token = request_token
            self._follow_feedback_pending = None
            return
        if self.dry_run:
            self.get_logger().info(
                'Dry run: would call %s data=%s'
                % (self.bodyfollow_mode_service, bool(enabled))
            )
            self._follow_feedback_completed_token = request_token
            self._follow_feedback_pending = None
            return

        if not self.follow_control_client.wait_for_service(timeout_sec=1.0):
            self.get_logger().error(
                'Body follow mode service is unavailable: %s'
                % self.bodyfollow_mode_service
            )
            if enabled:
                self._finish_follow_feedback(
                    request_token, False, 'control_service_unavailable')
            return

        request = SetBool.Request()
        request.data = bool(enabled)
        try:
            future = self.follow_control_client.call_async(request)
        except Exception as exc:
            self.get_logger().error(
                'Failed to send body follow service request data=%s: %s'
                % (enabled, exc)
            )
            if enabled:
                self._finish_follow_feedback(
                    request_token, False, 'control_request_failed')
            return
        future.add_done_callback(
            lambda completed, requested=bool(enabled), token=request_token:
            self._follow_control_response(
                completed, requested, token
            )
        )

    def _follow_control_response(self, future, enabled, request_token):
        if (
                request_token != self._follow_voice_request_token
                or request_token == self._follow_feedback_completed_token):
            return
        try:
            response = future.result()
        except Exception as exc:
            self.get_logger().error(
                'Body follow service call failed for data=%s: %s' % (enabled, exc)
            )
            if enabled:
                self._finish_follow_feedback(
                    request_token, False, 'control_response_failed')
            return

        if response.success:
            self.get_logger().info(
                'Body follow service request accepted: data=%s message=%s'
                % (enabled, response.message)
            )
            if enabled:
                try:
                    payload = json.loads(response.message)
                    if not isinstance(payload, dict):
                        raise ValueError('acceptance payload is not an object')
                    accepted = payload.get('accepted') is True
                    desired = payload.get('desired') is True
                    generation = payload.get(
                        'requestGeneration', payload.get('generation'))
                    if (
                            not accepted
                            or not desired
                            or isinstance(generation, bool)
                            or not isinstance(generation, int)
                            or generation <= 0):
                        raise ValueError('invalid accepted follow response')
                except (TypeError, ValueError, json.JSONDecodeError) as exc:
                    self.get_logger().error(
                        'Invalid body follow acceptance response: %s' % exc)
                    self._finish_follow_feedback(
                        request_token, False, 'invalid_control_response')
                    return
                pending = self._follow_feedback_pending
                if pending is None or pending['token'] != request_token:
                    return
                pending['generation'] = generation
                self._follow_status_next_poll = 0.0
        else:
            if enabled:
                self._finish_follow_feedback(
                    request_token, False, 'control_request_rejected')
            else:
                self._publish_feedback('/stop.wav')
            self.get_logger().error(
                'Body follow service rejected data=%s: %s'
                % (enabled, response.message)
            )

    @staticmethod
    def _classify_follow_feedback_status(payload, expected_generation):
        current_generation = payload.get('generation')
        request_generation = payload.get('requestGeneration')
        result_generation = payload.get('lastResultGeneration')
        result = payload.get('lastResult')

        for value in (
                current_generation, request_generation, result_generation):
            if isinstance(value, bool) or not isinstance(value, int):
                return 'protocol_error'

        if result_generation == expected_generation and result == 'failed':
            return 'failed'

        if (
                request_generation != expected_generation
                and current_generation > expected_generation):
            return 'superseded'

        if (
                request_generation == expected_generation
                and current_generation == expected_generation
                and payload.get('enabled') is True
                and payload.get('phase') == 'waiting_body'
                and payload.get('pending') is True
                and payload.get('controllerApplied') is False
                and payload.get('pipelineReady') is False
                and payload.get('modeEnabled') is True
                and payload.get('motionEnabled') is False
                and not payload.get('lastError')):
            return 'waiting_body'

        if (
                request_generation == expected_generation
                and result_generation == expected_generation
                and result == 'following'
                and payload.get('enabled') is True
                and payload.get('phase') == 'following'
                and payload.get('pending') is False
                and payload.get('controllerApplied') is True
                and payload.get('pipelineReady') is True
                and payload.get('modeEnabled') is True
                and payload.get('motionEnabled') is True
                and not payload.get('lastError')):
            return 'following'

        return 'pending'

    def _check_follow_feedback(self):
        pending = self._follow_feedback_pending
        if pending is None:
            return
        token = pending['token']
        if token != self._follow_voice_request_token:
            self._follow_feedback_pending = None
            return

        now = time.monotonic()
        if now >= pending['deadline']:
            self._finish_follow_feedback(token, False, 'status_timeout')
            return
        if pending['generation'] is None:
            # A current request generation can only come from this SetBool
            # response.  Do not claim an unrelated app/older following state.
            return
        if self._follow_status_future is not None:
            return
        if now < self._follow_status_next_poll:
            return
        self._follow_status_next_poll = now + self.follow_feedback_poll_sec
        if not self.follow_status_client.service_is_ready():
            return

        try:
            future = self.follow_status_client.call_async(Trigger.Request())
        except Exception as exc:
            self.get_logger().warn(
                'Failed to request body follow completion status: %s' % exc)
            return
        self._follow_status_future = future
        self._follow_status_future_token = token
        future.add_done_callback(
            lambda completed, request_token=token:
            self._follow_status_response(completed, request_token)
        )

    def _follow_status_response(self, future, request_token):
        if (
                self._follow_status_future is future
                and self._follow_status_future_token == request_token):
            self._follow_status_future = None
            self._follow_status_future_token = 0
        pending = self._follow_feedback_pending
        if (
                pending is None
                or request_token != self._follow_voice_request_token
                or pending['token'] != request_token):
            return
        if time.monotonic() >= pending['deadline']:
            self._finish_follow_feedback(
                request_token, False, 'status_timeout')
            return

        try:
            response = future.result()
        except Exception as exc:
            self.get_logger().warn(
                'Body follow completion status call failed: %s' % exc)
            return
        if not response.success:
            self.get_logger().warn(
                'Body follow completion status rejected: %s' % response.message)
            return
        try:
            payload = json.loads(response.message)
            if not isinstance(payload, dict):
                raise ValueError('status payload is not an object')
        except (TypeError, ValueError, json.JSONDecodeError) as exc:
            self.get_logger().error(
                'Invalid body follow completion status: %s' % exc)
            self._finish_follow_feedback(
                request_token, False, 'invalid_status_response')
            return

        outcome = self._classify_follow_feedback_status(
            payload, pending['generation'])
        if outcome == 'following':
            self._finish_follow_feedback(request_token, True, 'following')
        elif outcome == 'waiting_body':
            self._finish_follow_feedback(
                request_token, True, 'waiting_body')
        elif outcome in ('failed', 'protocol_error'):
            reason = payload.get('lastResultError') or outcome
            self._finish_follow_feedback(request_token, False, reason)
        elif outcome == 'superseded':
            self.get_logger().info(
                'Voice body follow feedback canceled because generation %d '
                'was superseded.' % pending['generation'])
            self._follow_feedback_pending = None

    def _finish_follow_feedback(self, request_token, succeeded, reason):
        if (
                request_token != self._follow_voice_request_token
                or request_token == self._follow_feedback_completed_token):
            return
        self._follow_feedback_completed_token = request_token
        self._follow_feedback_pending = None
        self._publish_feedback('/OK.wav' if succeeded else '/stop.wav')
        self.get_logger().info(
            'Voice body follow feedback completed token=%d success=%s reason=%s'
            % (request_token, bool(succeeded), reason))

    def _cleanup_stale_navigation_artifacts(self):
        """杀掉上一实例遗留的 nav2 组件容器、雷达驱动与 map->odom 限幅器。

        这些进程不会随 launch 一起被 SIGKILL 掉（它们是 launch 的子进程），
        积累下来会让 /scan 出现多个发布者、map->odom 出现多个发布者，导致
        AMCL 的消息过滤器被过期扫描塞满、定位长期起不来。
        跟随栈自己的进程（cgroup 里带 bodyfollow）不动。
        """
        killed = []
        for pattern in ('component_container_isolated', 'lslidar_driver_node',
                        'amcl_odom_limiter'):
            try:
                completed = subprocess.run(
                    ['pgrep', '-af', pattern],
                    stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    timeout=5.0)
            except Exception:
                continue
            for line in (completed.stdout or b'').decode('utf-8', 'replace').splitlines():
                fields = line.split(None, 1)
                if len(fields) != 2 or pattern not in fields[1]:
                    continue
                try:
                    pid = int(fields[0])
                except ValueError:
                    continue
                try:
                    with open('/proc/%d/cgroup' % pid, 'r') as handle:
                        cgroup = handle.read()
                except OSError:
                    continue
                if 'bodyfollow' in cgroup:
                    continue
                try:
                    os.kill(pid, signal.SIGKILL)
                    killed.append(pid)
                except OSError:
                    continue
        if killed:
            self.get_logger().warn(
                'Killed stale navigation artifacts (containers/lidar/limiter): %s'
                % killed)
        return killed
    def _launch_named_process(
        self,
        label,
        cmd,
        active_node_names,
        active_process_patterns=None,
        pass_fds=(),
    ):
        self._reap_finished_processes()

        if self._is_tracked_process_running(label):
            self.get_logger().warn('%s process is already running; ignore duplicate command.' % label)
            return None

        active_nodes = [node_name for node_name in active_node_names if self._is_node_active(node_name)]
        if active_nodes:
            active_pids = []
            for pattern in active_process_patterns or []:
                active_pids.extend(self._pgrep(pattern))
            active_pids = sorted(set(pid for pid in active_pids if pid > 1 and pid != os.getpid()))
            if active_pids:
                self.get_logger().warn(
                    '%s appears active because node(s) %s and process(es) %s exist; ignore duplicate command.'
                    % (label, active_nodes, active_pids)
                )
                return None
            self.get_logger().warn(
                '%s has stale ROS node(s) %s but no matching launch process; '
                'attempting cleanup before starting.' % (label, active_nodes)
            )
            # 2026-09-13: 上一实例被 SIGINT/SIGTERM/SIGKILL 拆掉后，composable
            # 容器可能没退干净；它残留的注册会让健康门一直等不到生命周期状态。
            # 先清理残留容器，清不掉就拒绝启动（避免组件挂到死容器上）。
            self._cleanup_stale_navigation_artifacts()
            time.sleep(2.0)
            remaining = [
                node_name for node_name in active_node_names
                if self._is_node_active(node_name)]
            if remaining:
                self.get_logger().error(
                    '%s still reports stale ROS node(s) %s after cleanup; '
                    'refusing to start a second instance because composable '
                    'nodes could attach to a dead component container.'
                    % (label, remaining)
                )
                return None

        launched = self._launch_process(cmd, label, pass_fds=pass_fds)
        if launched is not None:
            self._child_processes.append((label,) + launched)
        return launched

    def _begin_navigation_shutdown(self):
        self._reap_finished_processes()
        if self._navigation_shutdown is not None:
            self.get_logger().warn(
                'Navigation shutdown is already in progress; ignore duplicate '
                'cancel command.')
            return

        roots = self._navigation_launch_roots()
        if not roots:
            self.get_logger().warn(
                'No exact %s/%s navigation launch process found; no process was '
                'signalled. Cartographer and unrelated nav2_container processes '
                'are intentionally outside the fallback scope.'
                % (self.navigation_launch_package, self.navigation_launch_file)
            )
            return

        known_pids = set()
        for root_pid in roots:
            known_pids.update(self._process_tree_pids(root_pid))

        lifecycle_futures = {}
        for service_name, client in self.navigation_lifecycle_clients.items():
            if not (
                client.service_is_ready()
                or client.wait_for_service(timeout_sec=0.2)
            ):
                self.get_logger().warn(
                    'Nav2 lifecycle shutdown service is unavailable: %s'
                    % service_name)
                continue
            request = ManageLifecycleNodes.Request()
            request.command = ManageLifecycleNodes.Request.SHUTDOWN
            try:
                lifecycle_futures[service_name] = client.call_async(request)
            except Exception as exc:
                self.get_logger().warn(
                    'Failed to request Nav2 lifecycle shutdown through %s: %s'
                    % (service_name, exc))

        now = time.monotonic()
        self._navigation_shutdown = {
            'roots': roots,
            'known_pids': known_pids,
            'lifecycle_futures': lifecycle_futures,
            'phase': 'lifecycle',
            'deadline': now + self.navigation_lifecycle_shutdown_timeout_sec,
        }
        if lifecycle_futures and self.navigation_lifecycle_shutdown_timeout_sec > 0.0:
            self.get_logger().info(
                'Requested graceful Nav2 lifecycle shutdown through %s; wait up '
                'to %.1fs before signalling the exact launch root(s) %s.'
                % (
                    sorted(lifecycle_futures),
                    self.navigation_lifecycle_shutdown_timeout_sec,
                    roots,
                )
            )
            return

        self.get_logger().warn(
            'No lifecycle shutdown request can be awaited; proceeding with '
            'SIGINT for exact navigation launch root(s) %s.' % roots)
        self._start_navigation_signal_phase(
            'sigint', signal.SIGINT, self.navigation_sigint_timeout_sec,
            roots_only=True)

    def _navigation_launch_roots(self):
        roots = set()
        candidates = set(self._tracked_process_pids('navigation_launch'))
        candidates.update(self._pgrep(self.navigation_launch_file))
        candidates.update(self._pgrep(
            'ros2 launch %s %s'
            % (self.navigation_launch_package, self.navigation_launch_file)))
        for pid in candidates:
            if self._is_exact_navigation_launch_process(pid):
                roots.add(pid)
            else:
                self.get_logger().debug(
                    'Ignore pid=%s while locating navigation launch: command '
                    'line is not the exact configured ros2 launch.' % pid)
        return sorted(
            pid for pid in roots if pid > 1 and pid != os.getpid()
            and self._pid_exists(pid)
        )

    def _is_exact_navigation_launch_process(self, pid):
        tokens = self._process_cmdline_tokens(pid)
        if not tokens:
            return False
        ros2_positions = [
            index for index, token in enumerate(tokens)
            if os.path.basename(token) == 'ros2'
        ]
        if not ros2_positions:
            return False
        for index in range(len(tokens) - 2):
            if (
                tokens[index] == 'launch'
                and tokens[index + 1] == self.navigation_launch_package
                and os.path.basename(tokens[index + 2])
                == self.navigation_launch_file
                and any(ros2_index < index for ros2_index in ros2_positions)
            ):
                return True
        return False

    def _process_cmdline_tokens(self, pid):
        try:
            with open('/proc/%d/cmdline' % int(pid), 'rb') as cmdline_file:
                raw = cmdline_file.read()
        except (FileNotFoundError, ProcessLookupError):
            return []
        except Exception as exc:
            self.get_logger().warn(
                'Failed to inspect command line for pid=%s: %s' % (pid, exc))
            return []
        return [
            token.decode('utf-8', errors='replace')
            for token in raw.split(b'\0') if token
        ]

    def _advance_navigation_shutdown(self):
        shutdown = self._navigation_shutdown
        if shutdown is None:
            return

        now = time.monotonic()
        alive = self._navigation_shutdown_alive_pids()
        if not alive:
            phase = shutdown['phase']
            self._navigation_shutdown = None
            self.get_logger().info(
                'Navigation process tree exited during %s phase.' % phase)
            return

        phase = shutdown['phase']
        if phase == 'lifecycle':
            futures = shutdown['lifecycle_futures']
            complete = all(future.done() for future in futures.values())
            if not complete and now < shutdown['deadline']:
                return
            self._report_lifecycle_shutdown_results(futures, complete)
            self._start_navigation_signal_phase(
                'sigint', signal.SIGINT, self.navigation_sigint_timeout_sec,
                roots_only=True)
            return

        if now < shutdown['deadline']:
            return
        if phase == 'sigint':
            self.get_logger().warn(
                'Navigation launch did not exit within %.1fs after SIGINT; '
                'escalating to SIGTERM for remaining exact-tree pid(s) %s.'
                % (self.navigation_sigint_timeout_sec, alive))
            self._start_navigation_signal_phase(
                'sigterm', signal.SIGTERM,
                self.navigation_sigterm_timeout_sec, roots_only=False)
            return
        if phase == 'sigterm':
            self.get_logger().error(
                'Navigation launch did not exit within %.1fs after SIGTERM; '
                'force killing remaining exact-tree pid(s) %s.'
                % (self.navigation_sigterm_timeout_sec, alive))
            self._start_navigation_signal_phase(
                'sigkill', signal.SIGKILL, 1.0, roots_only=False)
            return

        self.get_logger().error(
            'Navigation pid(s) still appear alive one second after SIGKILL: %s'
            % alive)
        self._navigation_shutdown = None

    def _report_lifecycle_shutdown_results(self, futures, all_complete):
        if not all_complete:
            pending = sorted(
                name for name, future in futures.items() if not future.done())
            self.get_logger().warn(
                'Nav2 lifecycle shutdown timed out after %.1fs; pending=%s.'
                % (self.navigation_lifecycle_shutdown_timeout_sec, pending))
        for service_name, future in futures.items():
            if not future.done():
                continue
            try:
                response = future.result()
            except Exception as exc:
                self.get_logger().warn(
                    'Nav2 lifecycle shutdown call failed through %s: %s'
                    % (service_name, exc))
                continue
            if response is not None and response.success:
                self.get_logger().info(
                    'Nav2 lifecycle shutdown confirmed by %s.' % service_name)
            else:
                self.get_logger().warn(
                    'Nav2 lifecycle shutdown was rejected by %s.' % service_name)

    def _start_navigation_signal_phase(
        self, phase, sig, timeout_sec, roots_only
    ):
        shutdown = self._navigation_shutdown
        if shutdown is None:
            return
        self._refresh_navigation_known_pids()
        if roots_only:
            targets = [
                pid for pid in shutdown['roots'] if self._pid_exists(pid)
            ]
        else:
            targets = self._navigation_shutdown_alive_pids()
        targets = sorted(set(targets), reverse=not roots_only)
        self.get_logger().warn(
            'Sending %s to navigation %s: %s'
            % (signal.Signals(sig).name, 'launch root(s)' if roots_only
               else 'exact process tree', targets))
        self._signal_pids(targets, sig)
        shutdown['phase'] = phase
        shutdown['deadline'] = time.monotonic() + max(0.0, timeout_sec)

    def _refresh_navigation_known_pids(self):
        shutdown = self._navigation_shutdown
        if shutdown is None:
            return
        for root_pid in shutdown['roots']:
            if self._pid_exists(root_pid):
                shutdown['known_pids'].update(
                    self._process_tree_pids(root_pid))

    def _navigation_shutdown_alive_pids(self):
        shutdown = self._navigation_shutdown
        if shutdown is None:
            return []
        return sorted(
            pid for pid in shutdown['known_pids'] if self._pid_exists(pid)
        )

    def _kill_named_process_tree(self, label, root_patterns):
        self._reap_finished_processes()

        roots = []
        roots.extend(self._tracked_process_pids(label))
        for pattern in root_patterns:
            roots.extend(self._pgrep(pattern))

        roots = sorted(set(pid for pid in roots if pid > 1 and pid != os.getpid()))
        if not roots:
            self.get_logger().warn('No running process found for %s.' % label)
            return

        for root_pid in roots:
            self._terminate_process_tree(root_pid, label)
        self._reap_finished_processes()

    def _terminate_navigate_process(self, label):
        self._reap_finished_processes()
        roots = []
        if self._is_process_running(self._navigate_process):
            roots.append(self._navigate_process.pid)
        roots.extend(self._pgrep('ros2 run auto_recharge_ros2 navigate_to_charger'))
        roots.extend(self._pgrep('/auto_recharge_ros2/navigate_to_charger'))
        roots = sorted(set(pid for pid in roots if pid > 1 and pid != os.getpid()))
        if not roots:
            return
        for root_pid in roots:
            self._terminate_process_tree(root_pid, label)
        self._reap_finished_processes()

    def _tracked_process_pids(self, label):
        pids = []
        for process_label, process, _, _ in self._child_processes:
            if process_label == label and process.poll() is None:
                pids.append(process.pid)
        return pids

    def _pgrep(self, pattern):
        try:
            result = subprocess.run(
                ['pgrep', '-f', pattern],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
        except Exception as exc:
            self.get_logger().warn('Failed to search process pattern %s: %s' % (pattern, exc))
            return []

        pids = []
        for item in result.stdout.split():
            try:
                pid = int(item)
            except ValueError:
                continue
            if pid != os.getpid():
                pids.append(pid)
        return pids

    def _process_tree_pids(self, root_pid):
        pids = [root_pid]
        index = 0
        while index < len(pids):
            pid = pids[index]
            index += 1
            try:
                result = subprocess.run(
                    ['pgrep', '-P', str(pid)],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.DEVNULL,
                    text=True,
                    check=False,
                )
            except Exception:
                continue
            for item in result.stdout.split():
                try:
                    child_pid = int(item)
                except ValueError:
                    continue
                if child_pid not in pids:
                    pids.append(child_pid)
        return pids

    def _terminate_process_tree(self, root_pid, label):
        pids = self._process_tree_pids(root_pid)
        if not pids:
            return

        self.get_logger().warn('Terminating %s process tree: %s' % (label, pids))
        self._signal_pids(reversed(pids), signal.SIGTERM)
        time.sleep(1.5)

        alive = [pid for pid in pids if self._pid_exists(pid)]
        if alive:
            self.get_logger().warn('Force killing %s remaining process(es): %s' % (label, alive))
            self._signal_pids(reversed(alive), signal.SIGKILL)

    def _signal_pids(self, pids, sig):
        for pid in pids:
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
            except PermissionError as exc:
                self.get_logger().warn('No permission to signal pid %s: %s' % (pid, exc))
            except Exception as exc:
                self.get_logger().warn('Failed to signal pid %s: %s' % (pid, exc))

    def _pid_exists(self, pid):
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def _launch_ros2_run(self, executable, label, ros_args=None):
        cmd = [self.ros2_command, 'run', self.recharge_package, executable]
        if ros_args:
            cmd.extend(ros_args)
        return self._launch_process(cmd, label)

    def _launch_process(self, cmd, label, pass_fds=()):
        log_path = self._make_log_path(label)

        if self.dry_run:
            self.get_logger().info('Dry run: would execute %s' % ' '.join(cmd))
            return None

        log_file = None
        try:
            log_file = open(log_path, 'ab', buffering=0)
            log_file.write(('[voice_recharge_bridge] execute: %s\n' % ' '.join(cmd)).encode('utf-8'))
            process_env = os.environ.copy()
            process_env['PYTHONUNBUFFERED'] = '1'
            process = subprocess.Popen(
                cmd,
                stdout=log_file,
                stderr=subprocess.STDOUT,
                cwd=os.path.expanduser(os.getenv(
                    'WHEELTEC_ROS2_ROOT', '~/wheeltec_ros2')),
                env=process_env,
                start_new_session=True,
                pass_fds=tuple(pass_fds),
            )
        except Exception as exc:
            self.get_logger().error('Failed to launch %s: %s' % (label, exc))
            self._close_log(log_file)
            return None

        self.get_logger().info('Launched %s with pid=%s, log=%s' % (label, process.pid, log_path))
        return process, log_file, log_path

    def _make_log_path(self, label):
        os.makedirs(self.log_dir, exist_ok=True)
        stamp = datetime.now().strftime('%Y%m%d_%H%M%S')
        return os.path.join(self.log_dir, 'voice_recharge_%s_%s.log' % (label, stamp))

    def _publish_feedback(self, audio_file):
        msg = String()
        msg.data = audio_file
        self.feedback_pub.publish(msg)

    def _is_node_active(self, node_name):
        # rclpy's get_node_names() drops namespaces, so internal stacks that
        # reuse stock Nav2 base names (the map-free body-follow avoidance Nav2
        # at /nofmap) would look like the user-facing navigation launch and make
        # every navigation start look "stale".  Match name+namespace and skip
        # internal namespaces.
        try:
            internal = tuple(
                item.strip().strip('/')
                for item in os.getenv(
                    'STEMM_INTERNAL_NODE_NAMESPACES', 'nofmap'
                ).split(',')
                if item.strip().strip('/')
            )
            wanted = str(node_name).lstrip('/')
            for name, namespace in self.get_node_names_and_namespaces():
                if str(name).lstrip('/') != wanted:
                    continue
                ns = str(namespace or '').strip().strip('/')
                if ns and ns in internal:
                    continue
                return True
            return False
        except Exception as exc:
            self.get_logger().warn('Failed to inspect active ROS nodes: %s' % exc)
            return False
    @staticmethod
    def _is_process_running(process):
        return process is not None and process.poll() is None

    def _is_tracked_process_running(self, label):
        for process_label, process, _, _ in self._child_processes:
            if process_label == label and process.poll() is None:
                return True
        return False

    def _reap_finished_processes(self):
        self._advance_navigation_shutdown()

        if self._navigate_process is not None and self._navigate_process.poll() is not None:
            self.get_logger().info(
                'navigate_to_charger exited with code=%s, log=%s'
                % (self._navigate_process.returncode, self._navigate_log_path)
            )
            self._close_log(self._navigate_log)
            self._navigate_process = None
            self._navigate_log = None
            self._navigate_log_path = None

        alive = []
        cancel_finished = False
        for label, process, log_file, log_path in self._child_processes:
            if process.poll() is None:
                alive.append((label, process, log_file, log_path))
            else:
                self.get_logger().info('%s exited with code=%s, log=%s' % (label, process.returncode, log_path))
                self._close_log(log_file)
                if label == 'navigation_launch':
                    if self._active_navigation_start_generation is not None:
                        self._publish_navigation_start_event(
                            'launch_exited',
                            self._active_navigation_start_generation,
                            'navigation launch exited before health confirmation '
                            'with code=%s' % process.returncode,
                        )
                        self._clear_active_navigation_start()
                    self._release_navigation_launch_lock()
                if label == 'cancel_charge':
                    cancel_finished = True
        self._child_processes = alive

        if self._cancel_recharge_deadline is None:
            return

        timed_out = time.monotonic() >= self._cancel_recharge_deadline
        if not cancel_finished and not timed_out:
            return

        self._cancel_recharge_deadline = None
        if timed_out:
            self.get_logger().error(
                'cancel_charge exceeded %.1fs; forcing navigate-to-charger cleanup.'
                % self.cancel_recharge_timeout_sec
            )
            self._request_manager_stop_fallback()
            self._terminate_navigate_process('cancel_recharge_timeout')
        else:
            # The normal path publishes robot_recharge_flag=0 and waits for the
            # recharge node to exit.  This is only a final cleanup for a stale
            # wrapper/process that survived that handshake.
            self._terminate_navigate_process('cancel_recharge_postcheck')

    @staticmethod
    def _close_log(log_file):
        try:
            if log_file is not None:
                log_file.close()
        except Exception:
            pass


def main(args=None):
    rclpy.init(args=args)
    node = VoiceRechargeBridge()
    try:
        rclpy.spin(node)
    finally:
        node._reap_finished_processes()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
