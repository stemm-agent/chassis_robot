[Unit]
Description=STEM-M perception rejection-counter logger (torso_cpu_demo diag heartbeat)
After=network.target

[Service]
Type=simple
User=hnh
Environment=HOME=/home/hnh
Nice=10
ExecStart=/bin/bash -c 'source /opt/ros/humble/setup.bash >/dev/null 2>&1 && source /home/hnh/wheeltec_ros2/install/setup.bash >/dev/null 2>&1 && exec python3 /home/hnh/perception_diag_logger.py'
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
