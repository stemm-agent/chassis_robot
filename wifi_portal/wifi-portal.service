[Unit]
Description=Wheeltec single-NIC Wi-Fi provisioning portal
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/wheeltec/wheeltec_ros2/wifi_portal
Environment=WIFI_PORTAL_AP_IP=10.42.0.1
Environment=WIFI_PORTAL_AP_CONN=my-robot-ap
Environment=WIFI_PORTAL_AP_SSID=WheeltecRobot
Environment=WIFI_PORTAL_WIFI_IFACE=wlP1p1s0
Environment=WIFI_PORTAL_PORT=8080
ExecStartPre=/usr/bin/mkdir -p /home/wheeltec/wheeltec_ros2/wifi_portal/data
ExecStart=/usr/bin/python3 /home/wheeltec/wheeltec_ros2/wifi_portal/wifi_portal.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
